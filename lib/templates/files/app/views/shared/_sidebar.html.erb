<aside class="admin-sidebar">
  <div class="admin-brand">
    <%= link_to tg_app_name, admin_root_path %>
  </div>
  <nav class="admin-nav">
    <ul>
      <% admin_nav_items.each do |item| %>
        <li>
          <%= link_to item[:path], class: ("active" if request.path.start_with?(item[:path])) do %>
            <%= item[:icon] %>&nbsp;<%= item[:label] %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
</aside>
