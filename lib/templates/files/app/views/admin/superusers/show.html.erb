<% content_for :page_title, "Superuser ##{@superuser.id}" %>
<dl class="kv">
  <dt>ID</dt>          <dd><%= @superuser.id %></dd>
  <dt>Login</dt>       <dd><%= @superuser.login %></dd>
  <dt>Создан</dt>      <dd><%= l @superuser.created_at %></dd>
  <dt>Обновлён</dt>    <dd><%= l @superuser.updated_at %></dd>
</dl>
<div style="margin-top: var(--spacing-3);">
  <%= link_to "edit", edit_admin_superuser_path(@superuser), class: "btn btn--ghost" %>
  <%= button_to "delete", admin_superuser_path(@superuser), method: :delete, class: "btn btn--danger", data: { turbo_confirm: "Точно?" } %>
</div>
