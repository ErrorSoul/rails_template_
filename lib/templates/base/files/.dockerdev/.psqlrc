-- Настройки psql внутри dev-контейнера (монтируется в /root/.psqlrc).
\set QUIET 1

\pset null '[NULL]'
\pset linestyle unicode
\pset border 2

\timing on
\set COMP_KEYWORD_CASE upper
\set VERBOSITY verbose
\set HISTFILE /usr/local/hist/.psql_history
\set HISTCONTROL ignoredups
\set HISTSIZE 5000
\set PROMPT1 '%[%033[1m%]%M %n@%/%R%[%033[0m%]%# '
\set PROMPT2 ' '

\set QUIET 0
