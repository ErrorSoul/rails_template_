{
  // Скрипта `typecheck` намеренно нет: вендоренный ds/ не проходит `tsc` — 5 настоящих
  // расхождений пропсов (Input/Divider не объявляют `style`, SearchInput — `onSearch`).
  // Они ЕСТЬ И В АПСТРИМЕ: `tsc -p tsconfig.app.json` в ~/works/design_system/app даёт
  // те же пять TS2322 (плюс 34 TS6133 от noUnusedLocals). Чинить надо там, а не здесь:
  // правка снапшота ломает контракт «побайтово равен донору» (V2_PLAN §4.2).
  // Этот tsconfig нужен редактору и для `jsx: react-jsx`, а не для гейта.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/frontend/*"],
      "~/*": ["./app/frontend/*"]
    }
  },
  "include": ["app/frontend/**/*.ts", "app/frontend/**/*.tsx", "vite.config.ts", "vitest.config.ts"]
}
