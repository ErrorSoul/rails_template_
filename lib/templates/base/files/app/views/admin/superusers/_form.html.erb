<%= form_with model: superuser, url: superuser.persisted? ? admin_superuser_path(superuser) : admin_superusers_path, local: true do |f| %>
  <% if superuser.errors.any? %>
    <div class="flash flash--error">
      <%= superuser.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div class="field">
    <%= f.label :login %>
    <%= f.text_field :login %>
  </div>
  <div class="field">
    <%= f.label :password, superuser.persisted? ? "Новый пароль (оставь пустым чтобы не менять)" : "Пароль" %>
    <%= f.password_field :password %>
  </div>
  <%= f.submit "Сохранить", class: "btn" %>
  <%= link_to "Отмена", admin_superusers_path, class: "btn btn--ghost" %>
<% end %>
