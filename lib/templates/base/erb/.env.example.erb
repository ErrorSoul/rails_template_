# Copy this file to .env and fill in real values. .env is git-ignored.
APP_NAME=<%= @app_display_name %>
ADMIN_LOGIN=<%= @admin_login %>
ADMIN_PASS=<%= @admin_pass %>

# Database (overridden by docker-compose; for local non-docker dev set as needed)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/<%= app_name %>_development
