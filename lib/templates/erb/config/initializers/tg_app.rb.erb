# frozen_string_literal: true

# TG Mini App configuration — read from ENV.
# These are checked at boot to fail fast if dev forgot to populate .env.

required = %w[TG_BOT_TOKEN]
missing  = required.reject { |k| ENV[k].present? }

if missing.any? && Rails.env.development?
  warn "[tg_app] Missing ENV: #{missing.join(', ')} — set them in .env (initData verification will fail without them)"
end

raise "[tg_app] Missing ENV in production: #{missing.join(', ')}" if missing.any? && Rails.env.production?
